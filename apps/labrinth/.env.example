# ============================================
# BBSMC / Labrinth 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

DEBUG=true
RUST_LOG=info,sqlx::query=warn
SENTRY_DSN=none

SITE_URL=https://your-domain.com
CDN_URL=https://cdn.your-domain.com/bbsmc
CDN_PRIVATE_URL=none
SELF_ADDR=https://api.your-domain.com
LABRINTH_ADMIN_KEY=your-admin-key
RATE_LIMIT_IGNORE_KEY=your-ignore-key

DATABASE_URL=postgresql://labrinth:your-password@localhost/labrinth
DATABASE_MIN_CONNECTIONS=0
DATABASE_MAX_CONNECTIONS=16

MEILISEARCH_ADDR=http://localhost:7700
MEILISEARCH_KEY=modrinth

REDIS_URL=redis://localhost
REDIS_MAX_CONNECTIONS=10000
REDIS_NAMESPACE=none

BIND_ADDR=127.0.0.1:8000

MODERATION_SLACK_WEBHOOK=
PUBLIC_DISCORD_WEBHOOK=
CLOUDFLARE_INTEGRATION=false

STORAGE_BACKEND=local

MOCK_FILE_PATH=/tmp/modrinth

BACKBLAZE_KEY_ID=none
BACKBLAZE_KEY=none
BACKBLAZE_BUCKET_ID=none

S3_ACCESS_TOKEN=none
S3_SECRET=none
S3_URL=none
S3_REGION=none
S3_BUCKET_NAME=none
S3_PRIVATE_BUCKET_NAME=none

LOCAL_INDEX_INTERVAL=3600
VERSION_INDEX_INTERVAL=1800

RATE_LIMIT_IGNORE_IPS='["127.0.0.1"]'

WHITELISTED_MODPACK_DOMAINS='["cdn.your-domain.com", "github.com", "raw.githubusercontent.com"]'

ALLOWED_CALLBACK_URLS='["localhost", ".your-domain.com", "127.0.0.1"]'

# ============================================
# OAuth 第三方登录配置
# ============================================
# 回调地址格式: https://你的API域名/auth/callback/{provider}
# 例如: https://api.your-domain.com/auth/callback/github

# GitHub 登录 (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitLab 登录 (https://gitlab.com/profile/applications)
GITLAB_CLIENT_ID=none
GITLAB_CLIENT_SECRET=none

# Discord 登录 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=none
DISCORD_CLIENT_SECRET=none

# Microsoft 登录 (https://portal.azure.com -> App registrations)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Google 登录 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=none
GOOGLE_CLIENT_SECRET=none

# Bilibili 登录 (https://open.bilibili.com/)
BILIBILI_CLIENT_ID=none
BILIBILI_CLIENT_SECRET=none

# QQ 登录 (https://connect.qq.com/)
QQ_CLIENT_ID=none
QQ_CLIENT_SECRET=none

# ============================================
# 支付配置
# ============================================

# PayPal (https://developer.paypal.com/)
PAYPAL_API_URL=https://api-m.sandbox.paypal.com/v1/
PAYPAL_WEBHOOK_ID=none
PAYPAL_CLIENT_ID=none
PAYPAL_CLIENT_SECRET=none

# Stripe (https://dashboard.stripe.com/)
STRIPE_API_KEY=none
STRIPE_WEBHOOK_SECRET=none

# Steam 支付 (https://partner.steamgames.com/)
STEAM_API_KEY=none

# Tremendous 奖励 (https://www.tremendous.com/)
TREMENDOUS_API_URL=https://testflight.tremendous.com/api/v2/
TREMENDOUS_API_KEY=none
TREMENDOUS_PRIVATE_KEY=none
TREMENDOUS_CAMPAIGN_ID=none

# ============================================
# SMTP 邮件配置
# ============================================
# 常见 SMTP 服务商配置示例:
# QQ邮箱:    SMTP_HOST=smtp.qq.com,    SMTP_PORT=465, SMTP_USERNAME=xxx@qq.com, 密码为授权码
# 163邮箱:   SMTP_HOST=smtp.163.com,   SMTP_PORT=465, SMTP_USERNAME=xxx@163.com, 密码为授权码
# Gmail:     SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=xxx@gmail.com, 密码为应用密码
# Outlook:   SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# SendCloud: SMTP_HOST=smtp.sendcloud.net, SMTP_PORT=25
# 阿里云:    SMTP_HOST=smtpdm.aliyun.com, SMTP_PORT=465

SMTP_USERNAME=your-smtp-username@example.com
SMTP_PASSWORD=your-smtp-password-or-auth-code
SMTP_HOST=smtp.example.com

# 可选: SMTP 端口 (默认 465)
SMTP_PORT=465
# 可选: 是否启用 TLS (默认 true)
# SMTP_TLS=true

# 站点路径配置
SITE_VERIFY_EMAIL_PATH=none
SITE_RESET_PASSWORD_PATH=none
SITE_BILLING_PATH=none

# HCaptcha 人机验证 (https://hCaptcha.com/)
HCAPTCHA_SECRET=none
TAC_URL=none

# ============================================
# 其他第三方服务
# ============================================

# BeeHiV 邮件订阅 (https://beehiiv.com/)
BEEHIIV_PUBLICATION_ID=none
BEEHIIV_API_KEY=none

# 数据分析
ANALYTICS_ALLOWED_ORIGINS='["http://127.0.0.1:3000", "http://localhost:3000", "https://your-domain.com", "https://www.your-domain.com", "*"]'

# ClickHouse 数据分析
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=staging_ariadne

# MaxMind IP 地理位置
MAXMIND_LICENSE_KEY=none

# Flame 性能分析 (https://flame.io/)
FLAME_ANVIL_URL=none

# Aditude 广告
ADITUDE_API_KEY=none

# Pyro 通知
PYRO_API_KEY=none

# 飞书机器人
FEISHU_BOT_WEBHOOK=none

# 阿里云短信
ALIYUN_SMS_ACCESS_KEYID=none
ALIYUN_SMS_ACCESS_KEY_SECRET=none
ALIYUN_SMS_REGION=none
ALIYUN_SMS_REPORT_TEMPLETE_CODE=none
ALIYUN_SMS_SIGN_NAME=none

# 火山引擎
HUOSHAN_AK=none
HUOSHAN_SK=none

# 敏感数据加密密钥 (32字节 Base64)
ENCRYPTION_KEY=none

# 支付平台 (自定义)
SEVENPAY_API_URL=none
SEVENPAY_CREATE_ORDER_PATH=none
SEVENPAY_QUERY_ORDER_PATH=none
SEVENPAY_VERIFY_MERCHANT_PATH=none
SEVENPAY_KEYCODE=none
SEVENPAY_ALLOWED_IPS=none

DEV=false
